-- The shape of one labelled rule, GRACE-lang section 5 (assets/design/grammar-tree.md, `Rule`).
-- A page's lexicon (generated by grammar.py) extends this module with its words (W) and its
-- record verbs (V). Prose, NOTEs, WHYs and Term lines are never parsed.
abstract GraceCore = {
  flags startcat = Rule ;
  cat
    Rule ; Cond ; Clause ; [Clause]{2} ; Obl ; Modal ; V ; Op ;
    Obj ; Atom ; [Atom]{2} ; W ; [W]{1} ; Tail ; [Tail]{0} ;
  fun
    -- the statement: [IF condition THEN] subject modal act object tails
    RPlain : Atom -> Obl -> Rule ;
    RIf    : Cond -> Atom -> Obl -> Rule ;
    MkObl  : Modal -> V -> Obj -> [Tail] -> Obl ;
    -- the condition: one clause, or clauses joined by AND or by OR, never both
    COne : Clause -> Cond ;
    CAnd : [Clause] -> Cond ;
    COr  : [Clause] -> Cond ;
    CCmp    : Atom -> Op -> Atom -> Clause ;
    CExists : Atom -> Clause ;
    -- the object: none, a phrase, phrases joined by AND or OR, or a comparison the object states
    ONone : Obj ;
    OAtom : Atom -> Obj ;
    OAnd  : [Atom] -> Obj ;
    OOr   : [Atom] -> Obj ;
    OCmp  : Atom -> Op -> Atom -> Obj ;
    OGap  : Atom -> Op -> Obj ;          -- "a cap that X EXCEEDS": the compared side is the object
    -- the tails: PER, ONLY IF, and the closing citation
    TPer    : Atom -> Tail ;
    TOnlyIf : Cond -> Tail ;
    TCite   : Atom -> Tail ;
    -- a phrase is a run of words; its inner structure is the lexicon's, not the rule's
    AWords : [W] -> Atom ;
    WInt   : Int -> W ;
    -- the closed vocabulary, GRACE-lang section 13 and 14
    Must, MustNot, May : Modal ;
    Equals, NotEquals, Exceeds, NotExceeds, Precedes, NotPrecedes, IsIn, NotIn : Op ;
}
