{
  "name": "beacon-bun",
  "private": true,
  "type": "module",
  "description": "Beacon rendered from the Grace Commons corpus: Hono and TypeScript on Bun, XTDB. Built from SPEC.md and the patterns it names.",
  "scripts": {
    "stack": "bash stack/stack.sh",
    "test": "bash stack/stack.sh restart && bun test --timeout 30000",
    "css": "tailwindcss -i src/app.css -o dist/app.css --minify"
  },
  "dependencies": {
    "hono": "4.13.19",
    "postgres": "4.1.1"
  },
  "devDependencies": {
    "@mus/inks": "git+https://github.com/scottromack/inks.git#41ae94138be74bd01908a9e6f274d9ae224443f4",
    "@tailwindcss/cli": "4.3.5",
    "bun": "1.3.2",
    "tailwindcss": "4.3.5"
  }
}
